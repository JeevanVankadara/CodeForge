PORT=3000
CLIENT_ORIGIN=http://localhost:5173

DB_HOST=localhost
DB_USER=root
DB_PASSWORD=
DB_NAME=codeForge

JWT_SECRET=

REDIS_URL=redis://127.0.0.1:6379
RUN_CONCURRENCY=4
RUN_WAIT_MS=60000

# production -> secure cookies + JDoodle. Anything else -> Docker.
NODE_ENV=development
# Optional: force "jdoodle" or "docker" regardless of NODE_ENV.
EXECUTOR=

# Only needed when JDoodle is the executor.
JDOODLE_CLIENT_ID=
JDOODLE_CLIENT_SECRET=
