PORT=3000
CLIENT_ORIGIN=http://localhost:5173

# Supabase: Connect -> Session pooler URI (IPv4). SSL is on unless the host is localhost.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/codeforge

JWT_SECRET=

REDIS_URL=redis://127.0.0.1:6379
RUN_CONCURRENCY=4
RUN_WAIT_MS=150000
# Seconds a program may run per input, and seconds a compile may take.
RUN_TIME_LIMIT_S=10
COMPILE_LIMIT_S=60
# true = run the queue worker inside the API process (one Render service).
# false = start it separately with `npm run worker`.
RUN_WORKER=false

# production -> secure cross-site cookies.
NODE_ENV=development
# docker: one container per run (your machine). local: run inside this
# process's own container (Render, where there is no Docker daemon).
EXECUTOR=docker
