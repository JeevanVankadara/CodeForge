PORT=3000
CLIENT_ORIGIN=http://localhost:5173

DB_HOST=localhost
DB_USER=root
DB_PASSWORD=
DB_NAME=codeForge

JWT_SECRET=

REDIS_URL=redis://127.0.0.1:6379
RUN_CONCURRENCY=4
RUN_WAIT_MS=150000

# production -> secure cross-site cookies.
NODE_ENV=development
# docker: one container per run (your machine). local: run inside this
# process's own container (Render, where there is no Docker daemon).
EXECUTOR=docker
