# Base URL of the CodeForge backend (HTTP API + Socket.IO).
#
# Vite inlines this at BUILD time, so it has to be set before `npm run build`,
# not on the server that serves the built files.
#
# Local development (this is also the fallback if unset):
VITE_API_URL=http://localhost:3000

# Production example:
# VITE_API_URL=https://api.yourdomain.com
